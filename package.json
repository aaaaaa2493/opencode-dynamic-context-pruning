{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@aaaaaa2493/opencode-dcp",
    "version": "3.2.0",
    "type": "module",
    "description": "Hierarchical context compression for OpenCode with retained summary versions",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./tui": {
            "types": "./dist/tui.d.ts",
            "import": "./tui.tsx"
        }
    },
    "keywords": [
        "opencode",
        "opencode-plugin",
        "plugin",
        "context",
        "pruning",
        "optimization",
        "tokens"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aaaaaa2493/opencode-dynamic-context-pruning.git"
    },
    "bugs": {
        "url": "https://github.com/aaaaaa2493/opencode-dynamic-context-pruning/issues"
    },
    "homepage": "https://github.com/aaaaaa2493/opencode-dynamic-context-pruning#readme",
    "author": "tarquinen",
    "license": "AGPL-3.0-or-later",
    "peerDependencies": {
        "@opencode-ai/plugin": ">=1.18.29"
    },
    "dependencies": {
        "@anthropic-ai/tokenizer": "^0.0.4",
        "@opencode-ai/sdk": "^1.4.3",
        "@opentui/core": "^0.4.5",
        "@opentui/solid": "^0.4.5",
        "jsonc-parser": "^3.3.1",
        "solid-js": "^1.9.12"
    },
    "overrides": {
        "@babel/core": "7.29.7",
        "esbuild": "0.28.1"
    },
    "files": [
        "dist/",
        "lib/",
        "server.js",
        "tui.tsx",
        "README.md",
        "HIERARCHICAL.md",
        "LICENSE"
    ]
}
